<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!--
		System background role, NOT a hardcoded brand colour: regenerated from
		the wallpaper, so it tracks the system when the user uses a
		wallpaper-derived palette, and tracks a custom/basic colour profile
		when they pick one. Verified on-device to equal the Compose
		dynamicDarkColorScheme().background exactly (#0D0E12), so the splash,
		the window and the content can never disagree.
	-->
	<color name="pxn_window_background">@android:color/system_background_dark</color>
	<color name="launcher_fg">@android:color/system_neutral2_100</color>
	<color name="launcher_bg">@android:color/background_dark</color>

	<!-- Update page's changelog card, behind the rendered markdown. -->
	<color name="changelog_bg">@android:color/system_neutral1_900</color>
</resources>
